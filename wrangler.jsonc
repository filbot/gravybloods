{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gravybloods",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "gravybloods.com", "custom_domain": true }],
  // Static pages come straight from public/, so nothing else in the repo can be
  // published by accident. Only /api/* hits the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gravybloods-guestbook",
      "database_id": "3fe66f35-14a3-448a-80fe-a3c67a5d954f"
    }
  ],
  // New-entry notifications through Email Routing. The address must be a verified
  // destination on the account, and must match NOTIFY_TO in src/worker.js.
  "send_email": [{ "name": "NOTIFY", "destination_address": "filip@filbot.com" }],
  // TURNSTILE_SECRET is a Worker secret, set outside this file.
  "observability": { "enabled": true }
}
